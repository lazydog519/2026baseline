{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Q1：运行单个输入图",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "code/q1/solver.py",
        "${input:casePath}",
        "-n",
        "${input:cores}",
        "--config",
        "code/config.txt",
        "-o",
        "work/q1_latest.json",
        "--report",
        "work/q1_report.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Q2：运行单个输入图",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "code/q2/solver.py",
        "${input:casePath}",
        "-n",
        "${input:cores}",
        "--config",
        "code/config.txt",
        "-o",
        "work/q2_latest.json",
        "--report",
        "work/q2_report.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Q3：运行单个输入图",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "code/q3/solver.py",
        "${input:casePath}",
        "-n",
        "${input:cores}",
        "--config",
        "code/config.txt",
        "-o",
        "work/q3_latest.json",
        "--report",
        "work/q3_report.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "重绘论文全部图片",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "plots/replot.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "校验冻结代码与数据",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "verify.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "三问隔离输入复现检查",
      "type": "process",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "verify.py",
        "--smoke"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "casePath",
      "type": "promptString",
      "description": "输入图 JSON 路径（相对 final 或绝对路径）",
      "default": "examples/case_001.json"
    },
    {
      "id": "cores",
      "type": "pickString",
      "description": "核心数",
      "options": [
        "2",
        "3",
        "4",
        "5"
      ],
      "default": "5"
    }
  ]
}
